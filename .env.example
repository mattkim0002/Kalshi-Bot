# ─── Polymarket Credentials ───
# Get these from polymarket.com → Profile → Settings
POLYMARKET_PRIVATE_KEY=your-private-key-here
POLYMARKET_FUNDER_ADDRESS=0xYourWalletAddressHere

# Account type: 0 = EOA (MetaMask/hardware), 1 = Email (Magic.Link), 2 = Browser proxy
SIGNATURE_TYPE=1

# ─── Anthropic Claude API Key ───
# Get from: console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-your-key-here
