# ─── Kalshi Credentials ───
# Get from: kalshi.com → Settings → API → Create API Key
# Download the private key .pem file and place it in the project folder
KALSHI_API_KEY_ID=your-api-key-id-here
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key.pem

# ─── Anthropic Claude API Key ───
# Get from: console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-your-key-here
