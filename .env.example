# ─── Polymarket US Credentials ───
# Get from: polymarket.us/developer → Create API Key
# You'll receive a Key ID and a Secret Key (shown once — save it!)
POLYMARKET_KEY_ID=your-key-id-here
POLYMARKET_SECRET_KEY=your-base64-secret-key-here

# ─── Anthropic Claude API Key ───
# Get from: console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-your-key-here
