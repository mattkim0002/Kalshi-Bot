# ─── Polymarket.com Credentials ───
# POLYMARKET_PRIVATE_KEY: Your Polygon wallet private key (from MetaMask → Account Details → Export Private Key)
# POLYMARKET_FUNDER_ADDRESS: Your wallet address (0x...)
# POLYMARKET_SIGNATURE_TYPE: 0=MetaMask/hardware wallet, 1=Magic/email wallet, 2=Gnosis Safe
POLYMARKET_PRIVATE_KEY=0x_your_private_key_here
POLYMARKET_FUNDER_ADDRESS=0x_your_wallet_address_here
POLYMARKET_SIGNATURE_TYPE=1

# ─── Anthropic Claude API Key ───
# Get from: console.anthropic.com → API Keys → Create Key
ANTHROPIC_API_KEY=sk-ant-your-key-here
